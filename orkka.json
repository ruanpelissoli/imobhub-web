{
  "name": "imobhub-web",
  "run": {
    "targets": [
      {
        "key": "web",
        "label": "ImobHub Web",
        "kind": "web",
        "installCommand": "npm install",
        "command": "npm run dev",
        "port": 3000,
        "previewPath": "/",
        "restartOnMerge": true
      }
    ]
  }
}
